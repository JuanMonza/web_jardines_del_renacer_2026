# Activación visual y técnica del ambiente de capacitación
APP_ENV=training
NEXT_PUBLIC_APP_ENV=training
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos independiente. En local puede usar el mismo servidor, pero nunca el mismo nombre.
TRAINING_DB_HOST=localhost
TRAINING_DB_PORT=3306
TRAINING_DB_USER=usuario_local
TRAINING_DB_PASSWORD=definir_solo_en_env_training_local
TRAINING_DB_DATABASE=jardines_capacitacion_local
TRAINING_DB_SSL=

# Todos los correos simulados se redirigen exclusivamente a esta bandeja.
TRAINING_EMAIL_RECIPIENT=prueba.smtp@jardinesdelrenacer.co

# Contraseña local para las cuentas ficticias; nunca debe subirse al repositorio.
TRAINING_ADMIN_PASSWORD=definir_solo_en_env_training_local
